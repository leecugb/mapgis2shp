<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Map [
  <!-- 可替换为本地实际安装的中文字体 face-name -->
  <!ENTITY fontset_main "fontset-main">
]>
<Map srs="+init=epsg:3857" background-color="#ffffff">

  <!-- 字体集：优先中文，回退 DejaVu -->
  <FontSet name="fontset-main">
    <Font face-name="Noto Sans CJK SC Regular"/>
    <Font face-name="Noto Sans CJK SC Bold"/>
    <Font face-name="DejaVu Sans Book"/>
    <Font face-name="DejaVu Sans Bold"/>
  </FontSet>

  <!-- ==================== 样式定义 ==================== -->

  <!-- 1. 地质面色 -->
  <Style name="geology_polygons">
    <Rule>
      <!-- 使用 GeoJSON 中的 fill 字段作为面色 -->
      <PolygonSymbolizer fill="[fill]" fill-opacity="1.0" clip="true"/>
      <LineSymbolizer stroke="#555555" stroke-width="0.15" stroke-linecap="round" stroke-linejoin="round"/>
    </Rule>
  </Style>

  <!-- 2. 断裂带/构造岩浆岩带边界（仅边界） -->
  <Style name="overlay_boundaries">
    <Rule>
      <Filter>[layer] = 'LDZOFBB009'</Filter>
      <LineSymbolizer stroke="#d95f02" stroke-width="0.6" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LDZOFBB010'</Filter>
      <LineSymbolizer stroke="#8c510a" stroke-width="0.5" stroke-dasharray="6,4" stroke-linecap="round"/>
    </Rule>
  </Style>

  <!-- 3. 推断/解译面边界 -->
  <Style name="inferred_boundaries">
    <Rule>
      <LineSymbolizer stroke="#7b3294" stroke-width="1.0" stroke-dasharray="6,4" stroke-opacity="0.75" stroke-linecap="round"/>
    </Rule>
  </Style>

  <!-- 4. 水系 -->
  <Style name="water_polygons">
    <Rule>
      <PolygonSymbolizer fill="#a6cee3" fill-opacity="0.85"/>
      <LineSymbolizer stroke="#1f78b4" stroke-width="0.25"/>
    </Rule>
  </Style>

  <Style name="water_lines">
    <Rule>
      <LineSymbolizer stroke="#1f78b4" stroke-width="0.4" stroke-linecap="round"/>
    </Rule>
  </Style>

  <!-- 5. 构造线 -->
  <Style name="structural_lines">
    <Rule>
      <Filter>[layer] = 'LDZOFBA002'</Filter>
      <LineSymbolizer stroke="#333333" stroke-width="0.3" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LDZOFBA003'</Filter>
      <LineSymbolizer stroke="#e41a1c" stroke-width="0.7" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LDZOFBA005'</Filter>
      <LineSymbolizer stroke="#4daf4a" stroke-width="1.0" stroke-dasharray="6,4" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LHCPGDAC01'</Filter>
      <LineSymbolizer stroke="#ff7f00" stroke-width="0.6" stroke-dasharray="4,4" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LYGREBA001'</Filter>
      <LineSymbolizer stroke="#984ea3" stroke-width="0.6" stroke-dasharray="2,3" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LYGREBA004'</Filter>
      <LineSymbolizer stroke="#984ea3" stroke-width="0.6" stroke-dasharray="4,4" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LZLPGDJ002'</Filter>
      <LineSymbolizer stroke="#e41a1c" stroke-width="1.2" stroke-dasharray="6,4" stroke-linecap="round"/>
    </Rule>
    <Rule>
      <Filter>[layer] = 'LHTQGTA001'</Filter>
      <LineSymbolizer stroke="#377eb8" stroke-width="0.8" stroke-dasharray="4,4" stroke-linecap="round"/>
    </Rule>
  </Style>

  <!-- 6. 产状点（简化：黑色圆点；带角度的走向线/倾向短刺需预生成 SVG 或线要素） -->
  <Style name="attitudes_simple">
    <Rule>
      <MarkersSymbolizer
        marker-type="ellipse"
        fill="black"
        width="6"
        height="6"
        allow-overlap="true"
        ignore-placement="true"/>
      <!-- 若数据源已预生成短线，可用 LineSymbolizer 绘制走向线/倾向短刺 -->
    </Rule>
  </Style>

  <!-- 7. 地质代号注记 -->
  <Style name="unit_labels">
    <Rule>
      <TextSymbolizer
        name="[label]"
        fontset-name="fontset-main"
        size="9"
        fill="black"
        halo-fill="white"
        halo-radius="1.5"
        allow-overlap="false"
        placement="point"
        dy="0"
        dx="0"/>
    </Rule>
  </Style>

  <!-- 8. 水系注记 -->
  <Style name="water_labels">
    <Rule>
      <TextSymbolizer
        name="[label]"
        fontset-name="fontset-main"
        size="10"
        fill="#1f78b4"
        halo-fill="white"
        halo-radius="1.5"
        allow-overlap="false"
        placement="point"/>
      <!-- Mapnik 不直接支持 italic 属性，需为斜体单独注册 Italic 字体 face-name -->
    </Rule>
  </Style>

  <!-- ==================== 图层定义 ==================== -->

  <Layer name="geology_polygons" srs="+init=epsg:3857">
    <StyleName>geology_polygons</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/geology_polygons.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="overlay_polygons" srs="+init=epsg:3857">
    <StyleName>overlay_boundaries</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/overlay_polygons.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="inferred_boundaries" srs="+init=epsg:3857">
    <StyleName>inferred_boundaries</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/inferred_boundaries.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="water_polygons" srs="+init=epsg:3857">
    <StyleName>water_polygons</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/water_polygons.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="water_lines" srs="+init=epsg:3857">
    <StyleName>water_lines</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/water_lines.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="structural_lines" srs="+init=epsg:3857">
    <StyleName>structural_lines</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/structural_lines.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="attitudes" srs="+init=epsg:3857">
    <StyleName>attitudes_simple</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/attitudes.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="water_labels" srs="+init=epsg:3857">
    <StyleName>water_labels</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/water_labels.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

  <Layer name="unit_labels" srs="+init=epsg:3857">
    <StyleName>unit_labels</StyleName>
    <Datasource>
      <Parameter name="type">geojson</Parameter>
      <Parameter name="file">data/mapnik/unit_labels.geojson</Parameter>
      <Parameter name="encoding">utf-8</Parameter>
    </Datasource>
  </Layer>

</Map>
