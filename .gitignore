# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
dist_*/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Temporary / sensitive files
.pypirc
*.tmp
/tmp/

# JWD pipeline code — not part of the published package (hatch-excluded from
# sdist/wheel; geological semantics is out of mapgis2shp scope) and not
# version-controlled here
src/pymapgis/rendering/
src/pymapgis/semantics/

# MapGIS sample/test vector data (real survey data is excluded by default)
*.WT
*.WL
*.WP
*.WT~
*.WL~
*.WP~

# Synthetic fixtures and Writer-native batches are intended for source archives.
# Optional user-supplied NGAC JWD/SLIB and derivative SHP files stay external.
!tests/fixtures/mapgis/*.wt
!tests/fixtures/mapgis/*.wl
!tests/fixtures/mapgis/*.wp
!tests/fixtures/mapgis/*.WT
!tests/fixtures/mapgis/*.WL
!tests/fixtures/mapgis/*.WP
!tests/fixtures/mapgis/*.WT~
!tests/fixtures/mapgis/*.WL~
!tests/fixtures/mapgis/*.WP~
!tests/fixtures/writer_batch2/*.WT
!tests/fixtures/writer_batch2/*.WL
!tests/fixtures/writer_batch2/*.WP
!tests/fixtures/writer_batch3/*.WT
!tests/fixtures/writer_batch3/*.WL
!tests/fixtures/writer_batch3/*.WP
!tests/fixtures/writer_batch4/*.WT
!tests/fixtures/writer_batch4/*.WL
!tests/fixtures/writer_batch4/*.WP
tests/fixtures/jwd/
tests/fixtures/reader_native/

# Bundled USGS-role testdata and generic SLIB are explicitly distributable.
!tests/fixtures/testdata/
!tests/fixtures/testdata/*.WT
!tests/fixtures/testdata/*.WL
!tests/fixtures/testdata/*.WP
!tests/fixtures/slib/
!tests/fixtures/slib/*.lib
!tests/fixtures/usgs_conejo/native/
!tests/fixtures/usgs_conejo/native/*.WT
!tests/fixtures/usgs_conejo/native/*.WL
!tests/fixtures/usgs_conejo/native/*.WP

# MapGIS project / raster overlay files
*.MPJ
*.TIF.ovr

# Rendered maps, debug images, and figure outputs
*.png
*.PNG
*.jpg
*.jpeg
*.tif
*.tiff
*.mbtiles

# Keep the executable README example's actual USGS-derived geological map.
!docs/images/testdata_map.png

# Exceptions: keep paper figures (publication assets)
!paper/figures/*.png
!paper/figures/*.pdf
!mapgis2shp_submission/softwarex_architecture.png
!mapgis2shp_submission/jwd_map.png

# Local release and figure-audit work products
mapgis2shp_submission/wheel_quickstart_*/
mapgis2shp_submission/*.collision-audit.log
mapgis2shp_submission/*.text-audit.log
mapgis2shp_submission/*.collision-audit.pdf

# Generated analysis artifacts (regenerated from scripts, not source)
*_debug.png
conversation_context_*.jsonl
analysis_report.*
classification_report.*
deep_interpretation.*
detailed_parsing.*
systematic_classification.*
parsed_content.*
samples_summary.txt
