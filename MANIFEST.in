include README.md
include LICENSE
include CITATION.cff
include verify_pymapgis.py
include pymapgis_baseline.json
recursive-include docs *.md *.json
recursive-include src pymapgis *.py
recursive-include tests *.py *.json *.md *.WT *.WL *.WP
recursive-include examples *.py *.md

# Root-level real survey files stay out of distributions. Public synthetic
# binaries under tests/fixtures are intentionally included by the rules above.
exclude *.WT
exclude *.WL
exclude *.WP
exclude *.MPJ
exclude *.TIF.ovr
global-exclude *.pyc
